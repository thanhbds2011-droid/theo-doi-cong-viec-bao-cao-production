# ==========================================================
# THEO DÕI CÔNG VIỆC & BÁO CÁO - Environment template
# Copy thành .env.local CHỈ khi chạy local.
# Trên Vercel: Project -> Environment Variables.
# KHÔNG commit .env.local / Service Account JSON / secret thật.
# ==========================================================

# Firebase Web config (client/public config)
# API key phải copy trực tiếp từ Firebase Console -> Project settings -> Your apps -> Web app -> Config.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=theo-doi-cong-viec-va-bao-cao.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=theo-doi-cong-viec-va-bao-cao
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=theo-doi-cong-viec-va-bao-cao.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=902173699920
NEXT_PUBLIC_FIREBASE_APP_ID=1:902173699920:web:16f0df1e232f22fbcf8655
NEXT_PUBLIC_APP_VERSION=1.2.1

# Firebase Admin SDK - SERVER ONLY
FIREBASE_ADMIN_PROJECT_ID=theo-doi-cong-viec-va-bao-cao
FIREBASE_ADMIN_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_CLIENT_EMAIL
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"

# Gmail quản trị đầu tiên (SERVER ONLY)
INITIAL_ADMIN_EMAIL=YOUR_ADMIN_GMAIL

# Google Apps Script Drive Gateway - SERVER ONLY
APPS_SCRIPT_DRIVE_URL=YOUR_APPS_SCRIPT_DEPLOYMENT_EXEC_URL
APP_SHARED_SECRET=YOUR_SHARED_SECRET_FROM_APPS_SCRIPT

# OneSignal: CHƯA tích hợp trong phiên bản này.
